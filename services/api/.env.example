NEXA_APP_NAME=Nexa Core API
NEXA_ENVIRONMENT=development
NEXA_API_VERSION=0.1.0
NEXA_API_HOST=127.0.0.1
NEXA_API_PORT=8000
NEXA_WEB_ORIGIN=http://localhost:5173

# Local development
NEXA_DATABASE_URL=sqlite:///./nexa.db

# Production example:
# NEXA_DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/nexa

NEXA_OPENAI_API_KEY=your-openai-api-key
NEXA_OPENAI_MODEL=gpt-6-astra